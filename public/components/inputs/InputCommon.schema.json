                    "defaultValue": "rgba(0, 0, 0, 0.6)",
                    "cssVariable": "--form-input-label-info-icon-button-color",
                    "type": "color"
                },
                {
                    "id": "infoIconWidth",
                    "label": "Info icon width",
                    "defaultValue": "1.25rem",
                    "cssVariable": "--form-input-label-info-icon-width",
                    "type": "units"
                },
                {
                    "id": "infoIconHeight",
                    "label": "Info icon height",
                    "defaultValue": "1.25rem",
                    "cssVariable": "--form-input-label-info-icon-height",
                    "type": "units"
                }
            ]
        },
