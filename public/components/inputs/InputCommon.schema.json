{
    "controls": [
        {
            "id": "label",
            "label": "Label",
            "description": "Text field label",
            "defaultValue": "Field label",
            "type": "text"
        },
        {
            "id": "placeholder",
            "label": "Placeholder",
            "description": "Text field placeholder",
            "defaultValue": "Field placeholder",
            "type": "text"
        },
        {
            "id": "helperText",
            "label": "Hint",
            "description": "Text field hint text",
            "defaultValue": "Field hint",
            "type": "text"
        },
        {
            "id": "infoTooltipText",
            "label": "Info tooltip text",
            "description": "Shows icon with label with additional information",
            "defaultValue": "",
            "type": "text"
        },
        {
            "id": "size",
            "label": "Size",
            "description": "Filed size",
            "type": "radio",
            "defaultValue": "medium",
            "options": ["small", "medium"]
        },
        {
            "id": "disabled",
            "label": "Disabled",
            "description": "Shows field in disabled state",
            "defaultValue": false,
            "type": "boolean"
        },
        {
            "id": "required",
            "label": "Required",
            "description": "Shows field in required state",
            "defaultValue": false,
            "type": "boolean"
        },
        {
            "id": "isLoading",
            "label": "Is loading",
            "description": "Show loading indicator",
            "defaultValue": false,
            "type": "boolean"
        },
        {
            "id": "isClearInputButtonEnabled",
            "label": "Clear icon",
            "description": "Show clear icon",
            "defaultValue": false,
            "type": "boolean"
        },
        {
            "id": "error",
            "label": "Invalid",
            "description": "Shows field in invalid state",
            "defaultValue": false,
            "type": "boolean"
        }
    ],
    "styles": [
        {
            "type": "sectionTitle",
            "label": "Common field styles"
        },
        {
            "type": "group",
            "id": "fieldLabelGroup",
            "label": "Field label",
            "fields": [
                {
                    "id": "labelMargin",
                    "label": "Label margin",
                    "defaultValue": "0 0 5px 0",
                    "cssVariable": "--form-input-label-margin",
                    "type": "padding"
                },
                {
                    "id": "labelFontSize",
                    "label": "Label font size",
                    "defaultValue": "0.85rem",
                    "cssVariable": "--form-input-label-font-size",
                    "type": "units"
                },
                {
                    "id": "labelFontColor",
                    "label": "Label font color",
                    "defaultValue": "rgba(0, 0, 0, 0.6)",
                    "cssVariable": "--form-input-label-color",
                    "type": "color"
                },
                {
                    "id": "labelFontFocusedColor",
                    "label": "Label font focused color",
                    "defaultValue": "rgba(0, 0, 0, 0.6)",
                    "cssVariable": "--form-input-label-focused-color",
                    "type": "color"
                },
                {
                    "id": "labelFontErrorColor",
                    "label": "Label font error color",
                    "defaultValue": "#ec3238",
                    "cssVariable": "--form-input-label-error-color",
                    "type": "color"
                },
                {
                    "id": "labelFontDisabledColor",
                    "label": "Label font disabled color",
                    "defaultValue": "rgba(0, 0, 0, 0.38)",
                    "cssVariable": "--form-input-label-disabled-color",
                    "type": "color"
                }
            ]
        },
        {
            "type": "group",
            "id": "fieldLabelInfoTooltipGroup",
