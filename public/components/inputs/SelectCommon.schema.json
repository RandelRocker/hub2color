{
    "controls": [],
    "styles": [
        {
            "type": "sectionTitle",
            "label": "Common dropdown styles"
        },
        {
            "type": "group",
            "id": "fieldDropdownIconGroup",
            "label": "Field dropdown icon",
            "fields": [
                {
                    "id": "fieldDropdownIconColor",
                    "label": "Field dropdown icon color",
                    "defaultValue": "rgba(0, 0, 0, 0.54)",
                    "cssVariable": "--form-input-dropdown-icon-color",
                    "type": "color"
                }
            ]
        },
        {
            "type": "group",
            "id": "fieldDropdownListGroup",
            "label": "Field dropdown list",
            "fields": [
                {
                    "id": "fieldDropdownListMaxHeight",
                    "label": "Field dropdown list max height",
                    "defaultValue": "240px",
                    "cssVariable": "--form-input-dropdown-list-max-height",
                    "type": "units"
                },
                {
                    "id": "fieldDropdownListBackgroundColor",
                    "label": "Field dropdown list background color",
                    "defaultValue": "#ffffff",
                    "cssVariable": "--form-input-dropdown-list-background-color",
                    "type": "color"
                },
                {
                    "id": "fieldDropdownListItemHoverBackgroundColor",
                    "label": "Field dropdown list item hover background color",
                    "defaultValue": "rgba(0, 0, 0, 0.04);",
                    "cssVariable": "--form-input-dropdown-list-hover-background-color",
                    "type": "color"
                },
                {
                    "id": "fieldDropdownListItemActiveBackgroundColor",
                    "label": "Field dropdown list item active background color",
                    "defaultValue": "rgba(0, 0, 0, 0.08);",
                    "cssVariable": "--form-input-dropdown-list-active-background-color",
                    "type": "color"
                },
                {
                    "id": "fieldDropdownListItemFontColor",
                    "label": "Field dropdown list item font color",
                    "defaultValue": "rgba(0, 0, 0, 0.85)",
                    "cssVariable": "--form-input-dropdown-list-item-font-color",
                    "type": "color"
                }
            ]
        }
    ]
}
