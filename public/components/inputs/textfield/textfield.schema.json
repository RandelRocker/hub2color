        {
            "type": "group",
            "id": "inputLabelGroup",
            "label": "Input label",
            "fields": [
                {
                    "id": "labelMargin",
                    "label": "Label margin",
                    "defaultValue": "0 0 5px 0",
                    "cssVariable": "--form-input-label-margin",
                    "type": "padding"
                },
                {
                    "id": "labelFontSize",
                    "label": "Label font size",
                    "defaultValue": "0.85rem",
                    "cssVariable": "--form-input-label-font-size",
                    "type": "units"
                },
                {
                    "id": "labelFontColor",
                    "label": "Label font color",
                    "defaultValue": "rgba(0, 0, 0, 0.6)",
