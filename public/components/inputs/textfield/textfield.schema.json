{
    "controls": [
         {
            "id": "label",
            "label": "Label",
            "description": "Text input label",
            "defaultValue": "Input label",
            "type": "text"
        },
        {
            "id": "placeholder",
            "label": "Placeholder",
            "description": "Text input placeholder",
            "defaultValue": "Input placeholder",
            "type": "text"
        },
        {
            "id": "helperText",
            "label": "Hint",
            "description": "Text input hint text",
            "defaultValue": "Input hint",
            "type": "text"
        },
        {
            "id": "infoTooltipText",
            "label": "Info tooltip text",
            "description": "Shows icon with label with additional information",
            "defaultValue": "",
            "type": "text"
        },
        {
            "id": "size",
            "label": "Size",
            "description": "Input size",
            "type": "radio",
            "defaultValue": "medium",
            "options": ["small", "medium"]
        },
        {
            "id": "disabled",
            "label": "Disabled",
            "description": "Shows field in disabled state",
            "defaultValue": false,
            "type": "boolean"
        },
        {
            "id": "required",
            "label": "Required",
            "description": "Shows field in required state",
            "defaultValue": false,
            "type": "boolean"
        },
        {
            "id": "isLoading",
            "label": "Is loading",
            "description": "Show loading indicator",
            "defaultValue": false,
            "type": "boolean"
        },
        {
            "id": "isClearInputButtonEnabled",
            "label": "Clear icon",
            "description": "Show clear icon",
            "defaultValue": false,
            "type": "boolean"
        },
        {
            "id": "error",
            "label": "Invalid",
            "description": "Shows field in invalid state",
            "defaultValue": false,
            "type": "boolean"
        },
        {
            "id": "startAdornment",
            "label": "Start icon",
            "defaultValue": false,
            "description": "Show icon at the start of the input",
            "type": "boolean"
        },
        {
            "id": "endAdornment",
            "label": "End icon",
            "defaultValue": false,
            "description": "Show icon at the end of the input",
            "type": "boolean"
        }
    ],
    "styles": [
