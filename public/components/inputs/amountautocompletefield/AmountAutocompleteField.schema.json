{
    "controls": [
        {
            "id": "isSearchHighlightEnabled",
            "label": "Search highlight",
            "defaultValue": false,
            "description": "Highlight matching text in dropdown options",
            "type": "boolean"
        },
        {
            "id": "isSelectArrowDisabled",
            "label": "Hide dropdown arrow",
            "defaultValue": false,
            "description": "Hide the dropdown arrow icon",
            "type": "boolean"
        },
        {
            "id": "freeSolo",
            "label": "Free solo",
            "defaultValue": false,
            "description": "Allow any value to be entered, not just options from the list",
            "type": "boolean"
        },
        {
            "id": "currencyCode",
            "label": "Currency code",
            "defaultValue": "USD",
            "description": "Currency code",
            "type": "text"
        },
        {
            "id": "isCurrencySymbolAtTheLeft",
            "label": "Show currency symbol at left",
            "defaultValue": true,
            "description": "Show currency symbol at left",
            "type": "boolean"
        },
        {
            "id": "adornment",
            "label": "Adornment icon",
            "defaultValue": false,
            "description": "Show additional icon in the field",
            "type": "boolean"
        }
    ],
    "styles": [
        {
            "type": "sectionTitle",
            "label": "Common Currency styles"
        },
        {
            "type": "group",
            "id": "amountFieldIconsGroup",
            "label": "Currency symbol",
            "fields": [
                {
                    "id": "amountFieldCurrencySymbolColor",
                    "label": "Currency symbol color",
                    "defaultValue": "rgba(0, 0, 0, 0.54)",
                    "cssVariable": "--form-input-amount-field-currency-color",
                    "type": "color"
                }
            ]
        }
    ]
}
