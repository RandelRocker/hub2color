{
    "controls": [
        {
            "id": "startAdornment",
            "label": "Start icon",
            "defaultValue": false,
            "description": "Show icon at the start of the field",
            "type": "boolean"
        },
        {
            "id": "isCheckboxDisplayed",
            "label": "Show checkboxes",
            "defaultValue": true,
            "description": "Show checkboxes in dropdown list",
            "type": "boolean"
        }
    ],
    "styles": [
        {
            "type": "sectionTitle",
            "label": "Multiple select field styles"
        },
        {
            "type": "group",
            "id": "multipleSelectCounterGroup",
            "label": "Selected items counter",
            "fields": [
                {
                    "id": "multipleSelectCounterBackgroundColor",
                    "label": "Counter background color",
                    "defaultValue": "#6ECD8D",
                    "cssVariable": "--form-input-multiple-select-counter-background-color",
                    "type": "color"
                },
                {
                    "id": "multipleSelectCounterFontColor",
                    "label": "Counter font color",
                    "defaultValue": "#ffffff",
                    "cssVariable": "--form-input-multiple-select-counter-font-color",
                    "type": "color"
                },
                {
                    "id": "multipleSelectCounterFontSize",
                    "label": "Counter font size",
                    "defaultValue": "0.85rem",
                    "cssVariable": "--form-input-multiple-select-counter-font-size",
                    "type": "units"
                },
                {
                    "id": "multipleSelectCounterWidth",
                    "label": "Counter width",
                    "defaultValue": "22px",
                    "cssVariable": "--form-input-multiple-select-counter-width",
                    "type": "units"
                },
                {
                    "id": "multipleSelectCounterHeight",
                    "label": "Counter height",
                    "defaultValue": "22px",
                    "cssVariable": "--form-input-multiple-select-counter-height",
                    "type": "units"
                },
                {
                    "id": "multipleSelectCounterBorderRadius",
                    "label": "Counter border radius",
                    "defaultValue": "50%",
                    "cssVariable": "--form-input-multiple-select-counter-border-radius",
                    "type": "units"
                },
                {
                    "id": "multipleSelectCounterBorder",
                    "label": "Counter border",
                    "defaultValue": "1px solid rgba(0, 0, 0, 0.23)",
                    "cssVariable": "--form-input-multiple-select-counter-border",
                    "type": "border"
                },
                {
                    "id": "multipleSelectCounterBorderRadius",
                    "label": "Counter border radius",
                    "defaultValue": "50%",
                    "cssVariable": "--form-input-multiple-select-counter-border-radius",
                    "type": "borderRadius"
                }
            ]
        }
    ]
}
