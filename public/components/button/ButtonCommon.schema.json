{
    "controls": [
         {
            "id": "label",
            "label": "Label",
            "description": "Button text",
            "defaultValue": "Button",
            "type": "text"
        },
        {
            "id": "color",
            "label": "Color",
            "description": "Button colors",
            "type": "select",
            "defaultValue": "primary",
            "options": ["primary", "secondary", "error"]
        },
        {
            "id": "size",
            "label": "Size",
            "description": "Button size",
            "type": "radio",
            "defaultValue": "medium",
            "options": ["small", "medium", "large"]
        },
        {
            "id": "disabled",
            "label": "Disabled",
            "defaultValue": false,
            "description": "Disable button",
            "type": "boolean"
        },
        {
            "id": "loading",
            "label": "Is loading",
            "defaultValue": false,
            "description": "Show loading indicator",
            "type": "boolean"
        },
        {
            "id": "startIcon",
            "label": "Start icon",
            "defaultValue": false,
            "description": "Show icon before text",
            "type": "boolean"
        },
        {
            "id": "endIcon",
            "label": "End icon",
            "defaultValue": false,
            "description": "Show icon after text",
            "type": "boolean"
        }
    ],
    "styles": [
        {
            "type": "sectionTitle",
            "label": "Common button styles"
        },
        {
            "type": "group",
            "id": "buttonSizeGroup",
            "label": "Button size",
            "fields": [
                {
                    "id": "paddingSmall",
                    "label": "Small button padding",
                    "defaultValue": "4px 10px",
                    "cssVariable": "--button-size-small-padding",
                    "type": "padding"
                },
                {
                    "id": "paddingMedium",
                    "label": "Medium button padding",
                    "defaultValue": "6px 16px",
                    "cssVariable": "--button-size-medium-padding",
                    "type": "padding"
                },
                {
                    "id": "paddingLarge",
                    "label": "Large button padding",
                    "defaultValue": "8px 22px",
                    "cssVariable": "--button-size-large-padding",
                    "type": "padding"
                }
            ]
        },
        {
            "type": "group",
            "id": "buttonTextGroup",
            "label": "Button text",
            "fields": [
                {
                    "id": "fontSizeSmall",
                    "label": "Small button font size",
                    "defaultValue": "1rem",
                    "cssVariable": "--button-size-small-font-size",
                    "type": "units"
                },
                {
                    "id": "fontSizeMedium",
                    "label": "Medium button font size",
                    "defaultValue": "1.29rem",
                    "cssVariable": "--button-size-medium-font-size",
                    "type": "units"
                },
                {
                    "id": "fontSizeLarge",
                    "label": "Large button font size",
                    "defaultValue": "1.5rem",
                    "cssVariable": "--button-size-large-font-size",
                    "type": "units"
                },
                {
                    "id": "fontWeight",
                    "label": "Font weight",
                    "defaultValue": "500",
                    "cssVariable": "--button-general-font-weight",
                    "type": "number"
                },
                {
                    "id": "italic",
                    "label": "Italic",
                    "defaultValue": false,
                    "checkedValue": "italic",
                    "cssVariable": "--button-general-font-style",
                    "type": "boolean"
                },
                {
                    "id": "uppercase",
                    "label": "Uppercase",
                    "defaultValue": "uppercase",
                    "checkedValue": "uppercase",
                    "cssVariable": "--button-general-text-transform",
                    "type": "boolean"
                }
            ]
        },
        {
            "type": "group",
            "id": "buttonBorderGroup",
            "label": "Button border",
            "fields": [
                {
                    "id": "borderRadius",
                    "label": "Border Radius",
                    "defaultValue": "4px 4px 4px 4px",
                    "cssVariable": "--button-general-border-radius",
                    "type": "borderRadius"
                }
            ]
        },
        {
            "type": "group",
            "id": "buttonShadowGroup",
            "label": "Button shadow",
            "fields": [
                {
                    "id": "buttonShadow",
                    "label": "Button shadow",
                    "defaultValue": "1px 1px 1px 1px rgba(0, 0, 0, 0.5)",
                    "cssVariable": "--button-general-box-shadow",
                    "type": "boxShadow"
                },
                {
                    "id": "buttonShadowHover",
                    "label": "Button hover shadow",
                    "defaultValue": "1px 1px 1px 1px rgba(0, 0, 0, 0.5)",
                    "cssVariable": "--button-general-hover-box-shadow",
                    "type": "boxShadow"
                }
            ]
        }
    ]
}